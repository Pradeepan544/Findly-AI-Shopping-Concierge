OPENROUTER_API_KEY=Enter your key

# openrouter/free can route to any eligible free model.
# To pin Mistral, replace this with the exact Mistral free model slug
# currently shown as available in your OpenRouter model catalogue.
OPENROUTER_MODEL=dots-studio/dots-3-note-preview:free

FLASK_SECRET_KEY=change-this-to-a-long-random-string
DATA_PATH=amazon.csv
PORT=5000
